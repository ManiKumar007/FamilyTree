# Cloudflare Worker Proxy Environment Variables Template

# Cloudflare Worker Deployment Details
# Get these values after deploying the worker with `wrangler deploy`
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Supabase Configuration
# Direct URL (from https://app.supabase.com/project/[project]/settings/api)
SUPABASE_URL=https://vojwwcolmnbzogsrmwap.supabase.co

# Proxy URL - Set this to your deployed Cloudflare Worker URL
# One of these options:
# Option 1: Cloudflare Workers subdomain
SUPABASE_PROXY_URL=https://familytree-supabase-proxy.your-subdomain.workers.dev
# Option 2: Custom domain (if configured in Cloudflare)
# SUPABASE_PROXY_URL=https://supabase-proxy.yourdomain.com

# Supabase API Keys (from Project Settings > API)
SUPABASE_ANON_KEY=eyJhbG...your-anon-key-here...
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...your-service-role-key...

# === Backend Configuration ===
PORT=3000
NODE_ENV=production
APP_URL=https://familytree-web.vercel.app
INVITE_BASE_URL=https://familytree-web.vercel.app/invite

# Development only (set to false in production)
AUTH_BYPASS=false

# === Frontend Configuration (Flutter) ===
# These can also be passed as --dart-define flags during build
# SUPABASE_URL=https://vojwwcolmnbzogsrmwap.supabase.co
# SUPABASE_PROXY_URL=https://your-worker-url
# SUPABASE_ANON_KEY=your-anon-key

# === Testing ===
# Test connectivity after setting up proxy
# curl -X GET "https://your-proxy-url/rest/v1/users?limit=1" \
#   -H "Authorization: Bearer $SUPABASE_ANON_KEY"
